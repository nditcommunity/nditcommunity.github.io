<header class='site-header'>
  <div class='brand-bar'>
    <a
      class='brand'
      href='/'
      >Neurodiversity In Tech</a
    >
  </div>

  <nav
    class='site-nav'
    aria-label='Primary navigation'
  >
    <ul class='nav-primary'>
      <li>
        <a
          class='nav-item'
          href='/'
          {% if page.url == '/' %}
            aria-current='page'
          {% endif %}
          >Home</a
        >
      </li>
      <li>
        <a
          class='nav-item'
          href='/about'
          {% if page.url == '/about/' %}
            aria-current='page'
          {% endif %}
          >About</a
        >
      </li>
      <li>
        <a
          class='nav-item'
          href='/events'
          {% if page.url == '/events/' %}
            aria-current='page'
          {% endif %}
          >Events</a
        >
      </li>
    </ul>
    <ul class='nav-secondary'>
      <li>
        <a
          class='nav-item'
          href='/resources'
          {% if page.url == '/resources/' %}
            aria-current='page'
          {% endif %}
          >Resources</a
        >
      </li>
      <li>
        <a
          class='nav-item'
          href='/media'
          {% if page.url == '/media/' %}
            aria-current='page'
          {% endif %}
          >Media</a
        >
      </li>
      <li>
        <a
          class='nav-item'
          href='/contact'
          {% if page.url == '/contact/' %}
            aria-current='page'
          {% endif %}
          >Contact</a
        >
      </li>
      <li>
        <button
          class='nav-item theme-toggle'
          type='button'
          aria-label='Switch to dark mode'
          title='Switch to dark mode'
        >
          <span
            class='sun-icon theme-icon hidden'
            aria-hidden='true'
            >☀︎</span
          >
          <span
            class='moon-icon theme-icon'
            aria-hidden='true'
            >☾</span
          >
        </button>
      </li>
    </ul>
  </nav>
</header>
