{
  "name": "nd-in-tech",
  "version": "0.0.2",
  "description": "Website for Neurodiversity in Tech",
  "private": true,
  "keywords": [
    "website"
  ],
  "license": "MIT",
  "author": "Neurodiversity in Tech",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nditcommunity/nditcommunity.github.io.git"
  },
  "scripts": {
    "build": "npx @11ty/eleventy && node tools/bundle-css.js",
    "clean": "rm -rf _site",
    "debug": "DEBUG=* npx @11ty/eleventy",
    "dev": "npx @11ty/eleventy --serve",
    "dry-run": "npx @11ty/eleventy --dryrun",
    "build:eleventy:prod": "ELEVENTY_ENV=production eleventy && node tools/bundle-css.js",
    "prettier:write": "prettier --write .",
    "prettier:check": "prettier --check .",
    "test": "npm run build && npm run test:structure && npm run test:links && npm run test:ui",
    "test:structure": "node --test tests/structure.test.js",
    "test:ui": "playwright test",
    "test:links": "node tools/check-links.js",
    "test:links:external": "npm run build && node tools/check-links.js --external"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@shopify/prettier-plugin-liquid": "^1.4.4",
    "prettier": "^3.2.5"
  },
  "overrides": {
    "@11ty/recursive-copy": "^5.0.2"
  }
}
