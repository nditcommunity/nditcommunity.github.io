{
  "name": "nd-in-tech",
  "version": "0.0.2",
  "description": "Website for Neurodiversity in Tech",
  "private": true,
  "keywords": [
    "website"
  ],
  "license": "MIT",
  "author": "Neurodiversity in Tech",
  "repository": {
    "type": "git",
    "url": "git@github.com:nditcommunity/ndit-website.git"
  },
  "scripts": {
    "build": "npx @11ty/eleventy",
    "clean": "rm -rf _site",
    "debug": "DEBUG=* npx @11ty/eleventy",
    "dev": "npx @11ty/eleventy --serve",
    "dry-run": "npx @11ty/eleventy --dryrun",
    "build:eleventy:prod": "ELEVENTY_ENV=production eleventy",
    "prettier:write": "prettier --write .",
    "prettier:check": "prettier --check .",
    "test": "npm run test:structure && npm run test:ui",
    "test:structure": "node --test tests/structure.test.js",
    "test:ui": "playwright test"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@shopify/prettier-plugin-liquid": "^1.4.4",
    "prettier": "^3.2.5"
  },
  "overrides": {
    "@11ty/recursive-copy": "^5.0.2"
  }
}
